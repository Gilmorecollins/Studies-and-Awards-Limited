{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studiesandawards",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [
    {
      "name": "RATE",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "RATE_STRICT",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studiesandawards",
      "database_id": "aa03dec7-8ca4-43dd-9e70-0a19079a09eb",
      "migrations_dir": "migrations"
    }
  ]
}
